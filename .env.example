# Copy this file to .env and fill in real values. Never commit the real .env.

# Optional. Powers the AI-written match narrative (headline/reasoning) and
# small probability adjustments on top of the statistical model. Without
# this, the app still works fully — it just uses a plain, computed fallback
# narrative instead of AI-written prose.
#
# Free to get: sign up at https://console.groq.com (no credit card), open
# "API Keys" in the sidebar, create a key, and paste it below.
GROQ_API_KEY=

# Optional legacy fallback — only relevant if this project is still running
# inside Lovable's platform. Leave blank otherwise.
LOVABLE_API_KEY=

# Powers the daily Telegram digest (yesterday's Value Pick results + today's
# fresh picks), posted automatically once a day via Vercel Cron.
# 1. Create a bot: message @BotFather in Telegram, run /newbot, copy the token.
# 2. Create a channel, add your bot as an admin of it.
# 3. TELEGRAM_CHAT_ID is the channel's @username (e.g. "@maxaitips") or its
#    numeric chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# A random secret string (anything unguessable works) — Vercel automatically
# sends this back as a Bearer token when it triggers the cron job, which is
# how /api/daily-digest confirms a request is genuinely from Vercel's
# scheduler and not a random visitor hitting the URL.
CRON_SECRET=

# Optional — included as a link at the end of the Telegram digest message.
SITE_URL=
