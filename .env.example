# Copy this file to .env and fill in real values. Never commit the real .env.

# Optional. Powers the AI-written match narrative (headline/reasoning) and
# small probability adjustments on top of the statistical model. Without
# this, the app still works fully — it just uses a plain, computed fallback
# narrative instead of AI-written prose.
#
# Free to get: sign up at https://console.groq.com (no credit card), open
# "API Keys" in the sidebar, create a key, and paste it below.
GROQ_API_KEY=

# Optional legacy fallback — only relevant if this project is still running
# inside Lovable's platform. Leave blank otherwise.
LOVABLE_API_KEY=
